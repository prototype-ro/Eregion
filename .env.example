# Copy to .env for docker compose (or to frontend/.env.local for BACKEND_URL only). Never commit the real one.

# Backend (read by Spring Boot from the environment). Defaults in
# backend/src/main/resources/application.properties match docker-compose.yml.
EREGION_DB_URL=jdbc:postgresql://localhost:5432/eregion
EREGION_DB_USER=eregion
# Set a real password for any deployment. docker compose passes it to the database and the API.
EREGION_DB_PASSWORD=eregion

# dev or production. Production refuses a placeholder secret, refuses to start without a mail server,
# and always sends the login cookie over HTTPS only. The Docker image sets production by itself.
EREGION_ENV=dev

# At least 32 bytes. Generate one with: openssl rand -base64 48
# A placeholder is refused in production and whenever EREGION_PUBLIC_URL is https.
EREGION_JWT_SECRET=change-me-change-me-change-me-change-me
EREGION_JWT_TTL_MINUTES=720

# Origins of the site that serves the app, comma separated. State changing requests that use
# the login cookie must come from one of these.
EREGION_CORS_ORIGINS=http://localhost:3000

# Send the login cookie over HTTPS only. Set to true on any deployment.
EREGION_COOKIE_SECURE=false

# Public name of the site for the Caddy proxy in docker-compose.yml (gets the TLS certificate). Point its DNS here.
#EREGION_DOMAIN=eregion.example

# Frontend (frontend/.env.local). The browser only talks to the Next site, which forwards /api here.
BACKEND_URL=http://localhost:8080

# Rate limits (defaults shown). EREGION_RATE_ENABLED=false turns them all off, for automated tests only.
# EREGION_TRUST_PROXY=true makes the app believe X-Forwarded-For, which is right only behind a proxy you control
# that overwrites it (the Caddy service in docker-compose.yml does).
EREGION_RATE_ENABLED=true
EREGION_TRUST_PROXY=false
#EREGION_RATE_LOGIN_IP=20          # sign in attempts per network per 15 minutes
#EREGION_RATE_LOGIN_ACCOUNT=8      # sign in attempts per account per 15 minutes
#EREGION_RATE_REGISTER=10          # sign ups per network per hour
#EREGION_RATE_MAIL_IP=10           # verify/reset emails per network per hour
#EREGION_RATE_MAIL_ADDRESS=3       # verify/reset emails per address per hour
#EREGION_RATE_SEARCH=120           # card searches per user per minute
#EREGION_RATE_RESOLVE=20           # list lookups per user per minute
#EREGION_RATE_UPLOAD=40            # custom art uploads per user per minute
#EREGION_RATE_URL_IMPORT=30        # deck link imports per user per hour
#EREGION_RATE_PUBLIC=240           # public deck and Explore reads per network per minute
#EREGION_RATE_REPORT=10            # deck reports per user per hour
#EREGION_RATE_SAVE=30              # version saves per user per minute
#EREGION_RATE_ANALYSIS=30          # deck analyses per user per minute
#EREGION_RATE_PROXY=30             # art prompt generations per user per minute
#EREGION_RATE_LORE=30              # lore assistant calls per user per minute

# Proxy Creator / Lore Creator. Off unless EREGION_ASSISTANT_ENABLED=true: the site hides it and its model
# calls answer 404. When on, only accounts with a confirmed email can use it, and it needs EREGION_LLM_API_KEY.
EREGION_ASSISTANT_ENABLED=false
EREGION_LLM_API_KEY=
#EREGION_LLM_URL=https://api.deepseek.com/chat/completions
#EREGION_LLM_MODEL=deepseek-reasoner
#EREGION_LLM_JSON_MODEL=deepseek-chat

# Where the site is reachable by people. Emailed links (verify, reset) point here.
EREGION_PUBLIC_URL=http://localhost:3000
EREGION_MAIL_FROM=Eregion <no-reply@example.com>
# Real email. Required in production: the API will not start without SPRING_MAIL_HOST.
# Without it in development, emails are written to the API log instead of sent.
#SPRING_MAIL_HOST=smtp.example.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=
#SPRING_MAIL_PASSWORD=

# Custom art storage (it lives in the database): MB per player, and MB for the whole site before uploads pause.
#EREGION_ART_PER_USER_MB=100
#EREGION_ART_SITE_MB=20480

# Each deck report is emailed here as it arrives (needs mail). Blank keeps reports only in the deck_reports table.
EREGION_MODERATION_EMAIL=
# Accounts that can open /admin to handle reports, disable accounts and remove art. Comma separated emails.
EREGION_ADMIN_EMAILS=
