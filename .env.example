# Backend (read by Spring Boot from the environment). Defaults in
# backend/src/main/resources/application.properties match docker-compose.yml.
EREGION_DB_URL=jdbc:postgresql://localhost:5432/eregion
EREGION_DB_USER=eregion
EREGION_DB_PASSWORD=eregion

# At least 32 bytes. Generate one with: openssl rand -base64 48
EREGION_JWT_SECRET=change-me-change-me-change-me-change-me
EREGION_JWT_TTL_MINUTES=720

# Browser origins allowed to call the API, comma separated.
EREGION_CORS_ORIGINS=http://localhost:3000

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8080
