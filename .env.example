# Backend (read by Spring Boot from the environment). Defaults in
# backend/src/main/resources/application.properties match docker-compose.yml.
EREGION_DB_URL=jdbc:postgresql://localhost:5432/eregion
EREGION_DB_USER=eregion
EREGION_DB_PASSWORD=eregion

# dev or production. Production refuses a placeholder secret and always sends the login cookie over HTTPS only.
EREGION_ENV=dev

# At least 32 bytes. Generate one with: openssl rand -base64 48
EREGION_JWT_SECRET=change-me-change-me-change-me-change-me
EREGION_JWT_TTL_MINUTES=720

# Origins of the site that serves the app, comma separated. State changing requests that use
# the login cookie must come from one of these.
EREGION_CORS_ORIGINS=http://localhost:3000

# Send the login cookie over HTTPS only. Set to true on any deployment.
EREGION_COOKIE_SECURE=false

# Frontend (frontend/.env.local). The browser only talks to the Next site, which forwards /api here.
BACKEND_URL=http://localhost:8080

# Rate limits (defaults shown). EREGION_RATE_ENABLED=false turns them all off, for automated tests only.
# EREGION_TRUST_PROXY=true makes the app believe X-Forwarded-For, which is right only behind a proxy you control.
EREGION_RATE_ENABLED=true
EREGION_TRUST_PROXY=false
#EREGION_RATE_LOGIN_IP=20          # sign in attempts per network per 15 minutes
#EREGION_RATE_LOGIN_ACCOUNT=8      # sign in attempts per account per 15 minutes
#EREGION_RATE_REGISTER=10          # sign ups per network per hour
#EREGION_RATE_SEARCH=120           # card searches per user per minute
#EREGION_RATE_RESOLVE=20           # list lookups per user per minute

# Where the site is reachable by people. Emailed links (verify, reset) point here.
EREGION_PUBLIC_URL=http://localhost:3000
EREGION_MAIL_FROM=Eregion <no-reply@example.com>
# Real email: set these. Without SPRING_MAIL_HOST, emails are written to the API log instead of sent.
#SPRING_MAIL_HOST=smtp.example.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=
#SPRING_MAIL_PASSWORD=
